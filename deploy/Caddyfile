{$APP_DOMAIN} {
  encode gzip zstd

  reverse_proxy app:3010

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  request_body {
    max_size 25MB
  }
}

{$ADMIN_DOMAIN} {
  encode gzip zstd

  reverse_proxy app:3010

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  request_body {
    max_size 25MB
  }
}
