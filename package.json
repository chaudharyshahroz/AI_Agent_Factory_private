    "bcryptjs": "^2.4.3",
    "bullmq": "^5.26.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "framer-motion": "^12.39.0",
