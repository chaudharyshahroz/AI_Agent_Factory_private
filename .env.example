# App
NODE_ENV=development
APP_NAME="Categent"
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
AUTH_SECRET=
ENCRYPTION_KEY=
INITIAL_SUPER_ADMIN_EMAIL=

# Database
POSTGRES_DB=agentfactory
POSTGRES_USER=agentfactory
POSTGRES_PASSWORD=agentfactory_password
DATABASE_URL=postgresql://agentfactory:agentfactory_password@localhost:5432/agentfactory?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AgentFactory AI <noreply@example.com>"

# Optional integrations
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
